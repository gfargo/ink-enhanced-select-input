{
  "name": "ink-enhanced-select-input",
  "version": "1.5.1",
  "description": "An enhanced variant of the select input component for Ink",
  "keywords": [
    "ink",
    "cli",
    "tui",
    "select",
    "select-input",
    "multi-select",
    "prompt",
    "react",
    "terminal",
    "interactive",
    "component"
  ],
  "author": "gfargo <ghfargo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfargo/ink-enhanced-select-input.git"
  },
  "homepage": "https://github.com/gfargo/ink-enhanced-select-input#readme",
  "bugs": {
    "url": "https://github.com/gfargo/ink-enhanced-select-input/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "prestart": "yarn build",
    "start": "node dist/storybook.js",
    "build": "tsc",
    "dev": "yarn start",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && xo",
    "lint:fix": "prettier --write . && xo --fix",
    "pretest": "yarn build",
    "test": "ava",
    "test:ci": "yarn build && ava --serial",
    "coverage": "yarn build && c8 ava --serial",
    "test:fix": "yarn lint:fix && ava --update-snapshots"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/headless.js",
    "dist/headless.d.ts",
    "dist/enhanced-select-input",
    "changelog.md"
  ],
  "peerDependencies": {
    "ink": "^6 || ^7",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint/compat": "^2.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "chalk": "^6.0.0",
    "eslint-config-xo-react": "^0.31.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.2",
    "xo": "^4.0.0"
  },
  "ava": {
    "typescript": {
      "extensions": [
        "ts",
        "tsx"
      ],
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  }
}
